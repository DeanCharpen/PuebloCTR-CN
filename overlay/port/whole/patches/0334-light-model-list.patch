 }
 
 cLightMgr LightMgr;
+
+/* PORT (patch 0334, C3 of the 3DS port): the places of the light pool a light lives in, for setModel2,
+ * setCloth and setEsp (each looked at all nArray places, 100, on every model: 120-264 calls a frame of the r104 fight,
+ * 14-17 lights alive). The places with be_flag bit 0 when the list was made, in order; the loops test each light as
+ * before, so a light dead since is left out there. Bit 0 is set by the cLight constructor only (be_flag = 3), run by
+ * cLightMgr::construct, which marks the list old; another array (pArray, nArray, size) makes it again too.
+ * RE4_LIGHTLIST=0: every place, as before; 2: the list, and on each call every place checked: a light alive
+ * (be_flag & 3 == 3) not in the list is logged ("light list: ..."). */
+#include <stdlib.h>
+extern "C" void re4_log(const char* fmt, ...);
+int re4_light_list_dirty = 1;
+static const void* gLightListArray;
+static u32 gLightListN = ~0u, gLightListSize, gLightListCount, gLightListMissed, gLightListChecks;
+static int gLightListOn = -1;
+static u16 gLightListIdx[1024];
+
+static void lightListCheck(cLightMgr* m)
+{
+    u32 k = 0;
+    for (u32 i = 0; i < m->nArray && i < 1024; i++) {
+        while (k < gLightListCount && gLightListIdx[k] < i) {
+            k++;
+        }
+        const bool listed = k < gLightListCount && gLightListIdx[k] == i;
+        if (!listed && (m->fastAt(i)->be_flag & 3) == 3 && ++gLightListMissed <= 8) {
+            re4_log("light list: place %u alive (be_flag 0x%x), not in the list of %u (room r%03x)", (unsigned) i,
+                    (unsigned) m->fastAt(i)->be_flag, (unsigned) gLightListCount, (unsigned) pG->room_id);
+        }
+    }
+    if ((++gLightListChecks & 0xFFFF) == 0) {
+        re4_log("light list: %u calls checked, %u lights alive not in the list", (unsigned) gLightListChecks,
+                (unsigned) gLightListMissed);
+    }
+}
+
+const u16* re4_light_list(cLightMgr* m, u32* count)
+{
+    if (gLightListOn < 0) {
+        const char* v = getenv("RE4_LIGHTLIST");
+        gLightListOn = !(v && *v == '0') ? (v && *v == '2' ? 2 : 1) : 0;
+        re4_log("light list (patch 0334, RE4_LIGHTLIST %d): the lights' places a model looks at %s", gLightListOn,
+                gLightListOn ? "from the list" : "all");
+    }
+    const u32 n = m->nArray;
+    if (re4_light_list_dirty || (const void*) m->pArray != gLightListArray || n != gLightListN || m->size != gLightListSize) {
+        re4_light_list_dirty = 0;
+        gLightListArray = m->pArray;
+        gLightListN = n;
+        gLightListSize = m->size;
+        gLightListCount = 0;
+        for (u32 i = 0; i < n && i < 1024; i++) {
+            if (!gLightListOn || (m->fastAt(i)->be_flag & 1)) {
+                gLightListIdx[gLightListCount++] = (u16) i;
+            }
+        }
+    }
+    if (gLightListOn == 2) {
+        lightListCheck(m);
+    }
+    *count = gLightListCount;
+    return gLightListIdx;
+}
