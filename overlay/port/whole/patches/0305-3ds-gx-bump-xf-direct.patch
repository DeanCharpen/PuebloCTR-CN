# The 3DS port, stage 3.3c (docs 09-stage3-gx.md of the port research): the last register writes of
# the GX library that went as bytes after patch 0153 go straight into the GX decoder's state too:
# the BP writes of GXBump.c (its own GX_WRITE_SOME_REG5: GXSetTevDirect per TEV stage, ~760 a frame
# of r100), the XF blocks of the projection and the viewport and GX_WRITE_XF_REG_F_ (GXTransform.c,
# ~280). On the 3DS only. A port patch.
--- a/src/lib/GXBump.c
+++ b/src/lib/GXBump.c
@@ -18,6 +18,12 @@
 } while (0)
 #endif
 
+#if defined(__3DS__)
+// port: straight into the decoder, as GX_WRITE_RAS_REG (patch 0153, __gx.h)
+#undef GX_WRITE_SOME_REG5
+#define GX_WRITE_SOME_REG5(a, b) re4_gx_put_bp((u32)(b))
+#endif
+
 void GXSetTevIndirect(GXTevStageID tev_stage, GXIndTexStageID ind_stage, GXIndTexFormat format, GXIndTexBiasSel bias_sel, GXIndTexMtxID matrix_sel, GXIndTexWrap wrap_s, GXIndTexWrap wrap_t, GXBool add_prev, GXBool utc_lod, GXIndTexAlphaSel alpha_sel) {
     u32 reg;
 
