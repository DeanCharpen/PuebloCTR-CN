@@ -53,6 +53,15 @@
 
 void __GXSetProjection(void) {
     u32 reg = 0x00061020;
+#if defined(__3DS__)
+    {  // port: the 7 words straight into the decoder (patch 0153, __gx.h)
+        u32 w[7];
+        __builtin_memcpy(w, __GXData->projMtx, 6 * sizeof(f32));
+        w[6] = __GXData->projType;
+        re4_gx_put_xf(reg, w);
+        return;
+    }
+#endif
     GX_WRITE_U8(0x10);
     GX_WRITE_U32(reg);
 #if DEBUG
@@ -406,6 +415,13 @@
     oz = zmax + __GXData->zOffset;
 
     reg = 0x5101A;
+#if defined(__3DS__)
+    {  // port: the 6 words straight into the decoder (patch 0153, __gx.h)
+        f32 w[6] = {sx, sy, sz, ox, oy, oz};
+        re4_gx_put_xf(reg, w);
+        return;
+    }
+#endif
     GX_WRITE_U8(0x10);
     GX_WRITE_U32(reg);
     GX_WRITE_XF_REG_F(26, sx);
@@ -464,6 +480,16 @@
     } \
 } while (0)
 
+#if defined(__3DS__)
+// port: straight into the decoder (patch 0153, __gx.h)
+#undef GX_WRITE_XF_REG_F_
+#define GX_WRITE_XF_REG_F_(addr, value) \
+do { \
+    f32 xfData = (value); \
+    re4_gx_put_xf(0x1000 + (addr), &xfData); \
+} while (0)
+#endif
