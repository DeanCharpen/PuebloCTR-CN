# The 3DS port, stage 3.10: the AXFX ReverbHi of patch 0047 (on the game's core, 3 x 160 samples every
# 5 ms) with the integer conversions as one VCVT each on ARM (no VFP compare and flag transfer per
# check) and the delay lines in locals for a block. Same results. A port patch.
--- a/src/lib/reverb_hi.c
+++ b/src/lib/reverb_hi.c
@@ -188,6 +188,27 @@
 
 /* port: patch 0047, C for the Gekko assembly of the SDK: the same steps in the
  * same order, in single precision (fctiwz = truncation, fctiw = rounding). */
+#if defined(__arm__) && defined(__ARM_FP)
+/* port: patch 0158. VCVT gives the results of the checks below by itself: towards zero
+ * (VCVT) or to nearest, ties to even (VCVTR in the default rounding mode), saturated, a
+ * NaN 0; without a VFP compare and flag transfer each, which stall the VFP of the
+ * 3DS's ARM11 (the reverb runs 3 x 160 samples every 5 ms on the game's core). */
+static inline s32 AXFXPortTrunc(f32 v) {
+    f32 t;
+    s32 i;
+    __asm__("vcvt.s32.f32 %0, %1" : "=t"(t) : "t"(v));
+    __builtin_memcpy(&i, &t, 4);
+    return i;
+}
+
+static inline s32 AXFXPortRound(f32 v) {
+    f32 t;
+    s32 i;
+    __asm__("vcvtr.s32.f32 %0, %1" : "=t"(t) : "t"(v));
+    __builtin_memcpy(&i, &t, 4);
+    return i;
+}
+#else
 static s32 AXFXPortTrunc(f32 v) {
     if (v >= 2147483647.0f) {
         return 0x7FFFFFFF;
@@ -215,20 +236,44 @@
     }
     return (s32)r;
 }
+#endif
 
-static void AXFXPortWrite(AXFX_REVHI_DELAYLINE* dl, f32 v) {
-    dl->inputs[dl->inPoint >> 2] = v;
