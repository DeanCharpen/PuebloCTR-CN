-        dl->inPoint = 0;
+/* port: patch 0158. A delay line in locals for the 160 samples of HandleReverb (in
+ * samples; the line keeps bytes): stored through the line's f32 buffer, every field of
+ * rv was loaded and stored again for each sample otherwise. */
+typedef struct AXFXPortLine {
+    f32* buf;
+    s32 in;
+    s32 out;
+    s32 len;
+    f32 last;
+} AXFXPortLine;
+
+static inline void AXFXPortLoad(AXFXPortLine* l, const AXFX_REVHI_DELAYLINE* dl) {
+    l->buf = dl->inputs;
+    l->in = dl->inPoint >> 2;
+    l->out = dl->outPoint >> 2;
+    l->len = dl->length >> 2;
+    l->last = dl->lastOutput;
+}
+
+static inline void AXFXPortStore(const AXFXPortLine* l, AXFX_REVHI_DELAYLINE* dl) {
+    dl->inPoint = l->in << 2;
+    dl->outPoint = l->out << 2;
+    dl->lastOutput = l->last;
+}
+
+static inline void AXFXPortWrite(AXFXPortLine* l, f32 v) {
+    l->buf[l->in] = v;
+    if (++l->in == l->len) {
+        l->in = 0;
     }
 }
 
-static f32 AXFXPortRead(AXFX_REVHI_DELAYLINE* dl) {
-    f32 v = dl->inputs[dl->outPoint >> 2];
-    dl->outPoint += 4;
-    if (dl->outPoint == dl->length) {
-        dl->outPoint = 0;
+static inline f32 AXFXPortRead(AXFXPortLine* l) {
+    f32 v = l->buf[l->out];
+    if (++l->out == l->len) {
+        l->out = 0;
     }
     return v;
 }
