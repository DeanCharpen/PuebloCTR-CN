         AX_AUX_DATA auxData;
         auxData.l = &__AXBufferAuxB[__AXAuxCpuReadWritePosition][0];
         auxData.r = &__AXBufferAuxB[__AXAuxCpuReadWritePosition][160];
@@ -157,11 +163,30 @@
 }
 
 void AXRegisterAuxACallback(void (*callback)(void*, void*), void* context) {
+    re4_dsp_drain();
     __AXCallbackAuxA = callback;
     __AXContextAuxA = context;    
 }
 
 void AXRegisterAuxBCallback(void (*callback)(void*, void*), void* context) {
+    re4_dsp_drain();
     __AXCallbackAuxB = callback;
     __AXContextAuxB = context;    
 }
+
+/* port (stage 3.4b): runtime/dsp.cpp's lists behind the game (RE4_DSP_BEHIND) run the aux callbacks themselves,
+   on the buffers of the CPU's position of the frame (__AXProcessAux's), with the callbacks registered now (the game
+   changes them only after re4_dsp_drain). */
+u32 re4_ax_aux_position(void) {
+    return __AXAuxCpuReadWritePosition;
+}
+
+void re4_ax_aux(u32 position, void (**callbackA)(void*, void*), void** contextA, void (**callbackB)(void*, void*),
+                void** contextB, s32** bufferA, s32** bufferB) {
+    *callbackA = __AXCallbackAuxA;
+    *contextA = __AXContextAuxA;
+    *callbackB = __AXCallbackAuxB;
+    *contextB = __AXContextAuxB;
+    *bufferA = &__AXBufferAuxA[position % 3][0];
+    *bufferB = &__AXBufferAuxB[position % 3][0];
+}
