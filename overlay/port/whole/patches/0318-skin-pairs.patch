# The 3DS port, stage 3.6: the skinning loop (trans.cpp Sk1Loop) two vertices a pass, each with the same
# operations in the same order (the same results): one vertex's chains of multiply-adds run while the
# other's wait (the 3DS's VFP: 8 cycles a step); the input kind a template. RE4_SK1_PAIRS=0: as before.
# A port patch.
diff -ruN a/src/game/trans.cpp b/src/game/trans.cpp
--- a/src/game/trans.cpp	2026-11-04 14:50:46.637609365 +0900
+++ b/src/game/trans.cpp	2026-11-04 14:50:46.794752234 +0900
@@ -2577,17 +2577,105 @@
     }
 }
 
+/* port: Sk1Loop two vertices a pass, each with the same operations in the same order (the same results): one
+   vertex's chains of multiply-adds (8 cycles a step on the 3DS's VFP) run while the other's wait; the input kind
+   (B: s8 normals, else s16 positions) a template, not a branch a vertex; both results stored after. A pair with a
+   matrix index outside the locked cache, the last of an odd count and a GQR6 not of the kind go to Sk1Loop.
+   RE4_SK1_PAIRS=0: Sk1Loop alone. */
+template <int B>
+static void Sk1Pairs(void* dst, const void* src, u32 n)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* v = getenv("RE4_SK1_PAIRS");
+        on = !(v && v[0] == '0');
+    }
+    u32 gqr = sGqr6;
+    u32 type = B ? 6 : 7;
+    if (!on || ((gqr >> 16) & 7) != type || (gqr & 7) != type) {
+        Sk1Loop(dst, src, n, B);
+        return;
+    }
+    f32 ld = ldexpf(1.0f, -re4_gqr_scale(gqr >> 24));
+    f32 st = ldexpf(1.0f, re4_gqr_scale(gqr >> 8));
+    f32 lo = B ? -128.0f : -32768.0f;
+    f32 hi = B ? 127.0f : 32767.0f;
+    u32 i;
+
+    for (i = 0; i + 2 <= n; i += 2) {
+        f32 a[3], b[3], ra[3], rb[3];
+        u32 ia, ib;
+        int k;
+
+        if (B) {
+            const s8* in = (const s8*) src + i * 4;
+            a[0] = (f32) in[0] * ld;
+            a[1] = (f32) in[1] * ld;
+            a[2] = (f32) in[2] * ld;
+            ia = (u8) in[3];
+            b[0] = (f32) in[4] * ld;
+            b[1] = (f32) in[5] * ld;
+            b[2] = (f32) in[6] * ld;
+            ib = (u8) in[7];
+        } else {
+            const s16* in = (const s16*) src + i * 4;
+            a[0] = (f32) in[0] * ld;
+            a[1] = (f32) in[1] * ld;
+            a[2] = (f32) in[2] * ld;
+            ia = (u32) (s32) in[3];
+            b[0] = (f32) in[4] * ld;
+            b[1] = (f32) in[5] * ld;
+            b[2] = (f32) in[6] * ld;
+            ib = (u32) (s32) in[7];
+        }
+        if (ia >= RE4_LOCKED_CACHE_SIZE / 0x30 || ib >= RE4_LOCKED_CACHE_SIZE / 0x30) {
+            if (B) {
+                Sk1Loop((s8*) dst + i * 3, (const s8*) src + i * 4, 2, B);
+            } else {
+                Sk1Loop((s16*) dst + i * 3, (const s16*) src + i * 4, 2, B);
+            }
+            continue;
+        }
+        const f32* ma = (const f32*) (RE4_LC_BASE + ia * 0x30);
+        const f32* mb = (const f32*) (RE4_LC_BASE + ib * 0x30);
+        for (k = 0; k < 3; k++) {
+            ra[k] = re4_madds(ma[6 + k], a[2], re4_madds(ma[3 + k], a[1], re4_madds(ma[k], a[0], ma[9 + k])));
+            rb[k] = re4_madds(mb[6 + k], b[2], re4_madds(mb[3 + k], b[1], re4_madds(mb[k], b[0], mb[9 + k])));
+        }
+        if (B) {
+            s8* out = (s8*) dst + i * 3;
+            for (k = 0; k < 3; k++) {
+                out[k] = (s8) re4_quantize(ra[k] * st, lo, hi);
+                out[3 + k] = (s8) re4_quantize(rb[k] * st, lo, hi);
+            }
+        } else {
+            s16* out = (s16*) dst + i * 3;
+            for (k = 0; k < 3; k++) {
+                out[k] = (s16) re4_quantize(ra[k] * st, lo, hi);
+                out[3 + k] = (s16) re4_quantize(rb[k] * st, lo, hi);
+            }
+        }
+    }
+    if (i < n) {
+        if (B) {
+            Sk1Loop((s8*) dst + i * 3, (const s8*) src + i * 4, n - i, B);
+        } else {
+            Sk1Loop((s16*) dst + i * 3, (const s16*) src + i * 4, n - i, B);
+        }
+    }
+}
+
 // Skin `n` vertices (s16 x/y/z + s16 matrix index, 8 bytes) from src into dst (s16 x/y/z, 6 bytes)
 // with the matrix palette in locked cache (0xE0000000, ROMtx 0x30 each). GQR6 holds the fixed point scale.
 void CalcSk1_x(void* dst, void* src, u32 n)
 {
-    Sk1Loop(dst, src, n, 0); /* port: C version of the paired-single asm */
+    Sk1Pairs<0>(dst, src, n); /* port: C version of the paired-single asm (two vertices a pass) */
 }
 
 // Same for s8 normals (s8 x/y/z + u8 matrix index, 4 bytes) into s8 x/y/z (3 bytes).
 void CalcSk1_x2(void* dst, void* src, u32 n)
 {
-    Sk1Loop(dst, src, n, 1); /* port: C version of the paired-single asm */
+    Sk1Pairs<1>(dst, src, n); /* port: C version of the paired-single asm (two vertices a pass) */
 }
 
 // Sets GQR6 (the paired-single quantisation register the skinning loads use).
