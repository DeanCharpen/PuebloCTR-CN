+/* port (patch 0327): the movie through the 3DS's H.264 decoder (runtime/re4_movie_hw.h). The renderer shows its frame
+   where a GX texture names the buffer given here (its texels never read); the quad as the CRI frame's (512 x the
+   movie's height, cSofdec::drawQuad), one stage GX_REPLACE instead of the YUV -> RGB ones. */
+static void re4MvdTex(TexObj* tex, int h)
+{
+    if (tex->ybuf != NULL) {
+        return;
+    }
+    tex->width = 512;
+    tex->height = h;
+    tex->ybufsiz = GXGetTexBufferSize(256, 256, 4, 0, 0); /* GX_TF_RGB565 */
+    tex->cbufsiz = 32;
+    tex->ybuf = (u8*) MEM_ALLOC(tex->ybufsiz, 1, 13);
+    tex->cbuf = (u8*) MEM_ALLOC(tex->cbufsiz, 1, 13);
+    if (tex->ybuf == NULL || tex->cbuf == NULL) {
+        OSReport("can't allocate tex buf.\n");
+        if (tex->ybuf != NULL) {
+            Mem_free(tex->ybuf);
+        }
+        if (tex->cbuf != NULL) {
+            Mem_free(tex->cbuf);
+        }
+        tex->ybuf = NULL;
+        tex->cbuf = NULL;
+        return;
+    }
+    memset(tex->ybuf, 0, tex->ybufsiz);
+    DCFlushRange(tex->ybuf, tex->ybufsiz);
+    GXInitTexObj(&tex->ytobj, tex->ybuf, 256, 256, 4, 0, 0, 0); /* RGB565, clamped */
+    tex->ctobj = tex->ytobj;
+    re4_movie_hw_mark(tex->ybuf);
+}
+
+static void re4MvdTev()
+{
+    GXSetNumTexGens(1);
+    GXSetNumTevStages(1);
+    GXSetTevOrder(0, 0, 0, 0xFF);
+    GXSetTevOp(0, 3); /* GX_REPLACE */
+    GXSetTevSwapMode(0, 0, 0);
 }
