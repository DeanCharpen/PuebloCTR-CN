# The 3DS port, stage 3.6: EmAtCheck walks the active objects (about 250 in the village, almost none
# colliding) once per character: the first walk keeps the colliding objects and the other two go over those
# in the same order (__em_at_core changes positions only, so they pick the same objects), and the first walk
# prefetches the lines of the object 8 ahead in the order of the call before. Same logic. A port patch.
diff -ruN a/src/game/at_mod.cpp b/src/game/at_mod.cpp
--- a/src/game/at_mod.cpp	2026-11-03 19:45:29.887896461 +0900
+++ b/src/game/at_mod.cpp	2026-11-03 19:45:30.068984993 +0900
@@ -143,19 +143,63 @@
             m->atari.m_oldPos = m->atari.m_Pos;
         }
     }
-    for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o)) {
-        if ((o->atari.m_flag & 0x200) && o->atari.m_radius2 != 0.0f) {
-            o->atari.getPos(o, &o->atari.m_Pos);
+    /* port: the objects are about 250, almost none of them colliding, and the three walks over them cost more
+       than the rest (two cache lines an object, gone from the cache by the next character). The first walk keeps
+       the colliding ones and the other two go over those in the same order: __em_at_core moves bodies only
+       (pos, m_Pos), no flag, size or list changes, so they pick the same objects. The first walk asks for the
+       lines of the object 8 ahead in the order of the call before (a wrong guess only costs the hint). */
+    {
+        static cObj* s_order[256];
+        static u32 s_orderNum;
+        cObj* hit[64];
+        u32 nHit = 0;
+        u32 i = 0;
+        const u32 nOrder = s_orderNum;
+        int over = 0;
+
+        for (i = 0; i < 8 && i < nOrder; i++) {
+            __builtin_prefetch(s_order[i]);
+            __builtin_prefetch(&s_order[i]->atari.m_flag);
         }
-    }
-    for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o)) {
-        if ((o->atari.m_flag & 0x200) && o != pMod && o->atari.m_radius2 != 0.0f) {
-            __em_at_core(pMod, o);
+        i = 0;
+        for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o), i++) {
+            if (i + 8 < nOrder) {
+                __builtin_prefetch(s_order[i + 8]);
+                __builtin_prefetch(&s_order[i + 8]->atari.m_flag);
+            }
+            if (i < 256) {
+                s_order[i] = o;
+            }
+            if ((o->atari.m_flag & 0x200) && o->atari.m_radius2 != 0.0f) {
+                o->atari.getPos(o, &o->atari.m_Pos);
+                if (nHit < 64) {
+                    hit[nHit++] = o;
+                } else {
+                    over = 1;
+                }
+            }
         }
-    }
-    for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o)) {
-        if ((o->atari.m_flag & 0x200) && o->atari.m_radius2 != 0.0f) {
-            o->atari.m_oldPos = o->atari.m_Pos;
+        s_orderNum = i < 256 ? i : 256;
+        if (!over) {
+            for (i = 0; i < nHit; i++) {
+                if (hit[i] != pMod) {
+                    __em_at_core(pMod, hit[i]);
+                }
+            }
+            for (i = 0; i < nHit; i++) {
+                hit[i]->atari.m_oldPos = hit[i]->atari.m_Pos;
+            }
+        } else {
+            for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o)) {
+                if ((o->atari.m_flag & 0x200) && o != pMod && o->atari.m_radius2 != 0.0f) {
+                    __em_at_core(pMod, o);
+                }
+            }
+            for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o)) {
+                if ((o->atari.m_flag & 0x200) && o->atari.m_radius2 != 0.0f) {
+                    o->atari.m_oldPos = o->atari.m_Pos;
+                }
+            }
         }
     }
     PartsWorldPosCalc(pMod);
