+            const Re4SkinTask& a = re4SkinTasks[p.task];
+            const Re4SkinTask& b = re4SkinTasks[p.task + 1];
+            re4_skin_head_fn((int) (&s - re4SkinScratch), re4_skin_gen, a.src, a.dst, a.n, b.dst, b.n, b.kind);
