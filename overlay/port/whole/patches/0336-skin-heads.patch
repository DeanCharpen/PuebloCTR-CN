+void (*re4_skin_head_fn)(int side, unsigned gen, const void* src, const void* pos, unsigned posN, const void* nrm,
+                         unsigned nrmN, int nrmKind);
+unsigned re4_skin_gen;  // the generation of the jobs being put (re4SkinEnd: the next)
