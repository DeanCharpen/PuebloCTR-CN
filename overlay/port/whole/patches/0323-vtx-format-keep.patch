diff -ruN a/src/lib/GXAttr.c b/src/lib/GXAttr.c
--- a/src/lib/GXAttr.c	2026-11-05 00:26:10.574216778 +0900
+++ b/src/lib/GXAttr.c	2026-11-05 00:26:10.849901835 +0900
@@ -640,3 +640,57 @@
     GX_WRITE_XF_REG(0x3F, nTexGens);
     __GXData->dirtyState |= 4;
 }
+
+/* port (3.6, patch 0323): the vertex format commonModelTrans sets for a model depends on a key (the model's flags
+   and position shift) only. re4_gx_vtx_keep stores the key and the words its calls left in __GXData;
+   re4_gx_vtx_same says whether the next model with that key finds the same words, and then it leaves its calls out:
+   from the same words they give the same words, and the CP registers either hold them or a dirty bit still says
+   they will be written. RE4_VTX_KEEP=0: always the calls. Not while display lists carry register commands (3DS). */
+#include <stdlib.h>
+
+static int re4VtxOn = -1;
+static int re4VtxValid;
+static u32 re4VtxKey, re4VtxWords[6];
+
+static void re4VtxRead(u32* w)
+{
+    w[0] = __GXData->vcdLo;
+    w[1] = __GXData->vcdHi;
+    w[2] = (u32) __GXData->hasNrms | ((u32) __GXData->hasBiNrms << 8) | ((u32) __GXData->nrmType << 16);
+    w[3] = __GXData->vatA[0];
+    w[4] = __GXData->vatB[0];
+    w[5] = __GXData->vatC[0];
+}
+
+int re4_gx_vtx_same(u32 key)
+{
+    u32 w[6];
+    int i;
+
+    if (re4VtxOn < 0) {
+        const char* e = getenv("RE4_VTX_KEEP");
+        re4VtxOn = e ? atoi(e) : 1;
+    }
+#if defined(__3DS__)
+    if (re4_gxq_list_regs) {
+        return 0;
+    }
+#endif
+    if (!re4VtxOn || !re4VtxValid || key != re4VtxKey) {
+        return 0;
+    }
+    re4VtxRead(w);
+    for (i = 0; i < 6; i++) {
+        if (w[i] != re4VtxWords[i]) {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+void re4_gx_vtx_keep(u32 key)
+{
+    re4VtxKey = key;
+    re4VtxRead(re4VtxWords);
+    re4VtxValid = 1;
+}
