+
+/* port (3.6, patch 0324): the skinning of the models in Trans' objTrans/emTrans loops as jobs. Their vertices go into
+   the primary buffer this frame fills (pPosBuf/pNrmBuf[DblBufIdx]), which only the next frame's Render() reads (the GX
+   thread, through GXSetArray). A job: destination, source, count, GQR6, a copy of the model's palette, the kind. Who is
+   free takes the next one (re4_skin_help, an atomic counter): the GX thread in its idle time (gx_thread_3ds.cpp, woken
+   through re4_skin_wake_fn), the game while it waits for the GX thread, and the game at the end of Render_done
+   (re4SkinJoin: the rest, then it waits for the jobs started) -- before Block.checkCommand/DC.check may free a model's
+   data and before the next Render(). Linux: no GX thread, the game runs them there. RE4_SKIN_JOBS=0: the original. */
+namespace {
+struct Re4SkinJob {
+    void* dst;
+    const void* src;
+    u32 n;
+    u32 gqr;
+    const u8* lc;
+    int kind;  // 1: s8 normals (CalcSk1_x2), 0: s16 (CalcSk1_x)
+};
+const u32 kRe4SkinJobs = 512;
+const u32 kRe4SkinArena = 96u << 10;  // bench5 16-36 KB a frame; full: skinned at once
+Re4SkinJob re4SkinJobs[kRe4SkinJobs];
+alignas(32) u8 re4SkinArena[kRe4SkinArena];
+u32 re4SkinArenaUsed;
+const u8* re4SkinLc;      // the copy of the palette the last MakeWeightPalette made (0: none)
+int re4SkinOn = -1;       // RE4_SKIN_JOBS
+int re4SkinDeferring;     // inside Trans' model loops
+u32 re4SkinCount;         // jobs published (the game writes)
+u32 re4SkinNext;          // the next job to take
+u32 re4SkinDone;          // jobs finished
+u32 re4SkinStat[3][2];    // by who (0 GX thread, 1 the game waiting, 2 the join): jobs, vertices
+u32 re4SkinFrames, re4SkinPalBytes, re4SkinDirect;
+}  // namespace
+
+extern "C" {
+void (*re4_skin_wake_fn)(void);  // gx_thread_3ds.cpp: wakes the GX thread if it sleeps
+int re4_skin_help(int who);
+void re4SkinJoin(void);          // main.cpp, after Render_done
+}
+
+static void re4SkinRun(const Re4SkinJob& j)
+{
+    if (j.kind) {
+        Sk1Pairs<1>(j.dst, j.src, j.n, j.gqr, j.lc);
+    } else {
+        Sk1Pairs<0>(j.dst, j.src, j.n, j.gqr, j.lc);
+    }
+}
+
+static void re4SkinDefer(int on)
+{
+    if (re4SkinOn < 0) {
+        const char* e = getenv("RE4_SKIN_JOBS");
+        re4SkinOn = e ? atoi(e) : 1;
+        Sk1Pairs<0>(0, 0, 0, 0x00070007);  // their getenv once, here on the game's thread (no vertices)
+        Sk1Pairs<1>(0, 0, 0, 0x00060006);
+    }
+    re4SkinDeferring = on && re4SkinOn;
+    re4SkinLc = 0;
+}
+
+// A model with shapes: ResetShape puts its 8-byte source vertices into the 6-byte position buffer, the rest runs
+// into the normals' buffer allocated after it, and the positions read it in place -- the normals must come after
+// them, as before: both skinned at once (only for this model info; the next palette starts over).
+static void re4SkinNow()
+{
+    re4SkinLc = 0;
+}
+
+static void re4SkinPalette(int n)
+{
+    re4SkinLc = 0;
+    if (!re4SkinDeferring || n <= 0) {
+        return;
+    }
+    u32 bytes = (u32) n * 0x30;
+    if (bytes > RE4_LOCKED_CACHE_SIZE) {
+        bytes = RE4_LOCKED_CACHE_SIZE;
+    }
+    if (re4SkinArenaUsed + bytes > kRe4SkinArena) {
+        return;
+    }
+    u8* p = re4SkinArena + re4SkinArenaUsed;
+    memcpy(p, (const void*) RE4_LC_BASE, bytes);
+    re4SkinArenaUsed += (bytes + 31) & ~31u;
+    re4SkinPalBytes += bytes;
+    re4SkinLc = p;
+}
+
+static void re4SkinPut(void* dst, void* src, u32 n, int kind)
+{
+    const u32 c = re4SkinCount;
+    if (!re4SkinDeferring || !re4SkinLc || c >= kRe4SkinJobs) {
+        re4SkinDirect++;
+        if (kind) {
+            CalcSk1_x2(dst, src, n);
+        } else {
+            CalcSk1_x(dst, src, n);
+        }
+        return;
+    }
+    Re4SkinJob& j = re4SkinJobs[c];
+    j.dst = dst;
+    j.src = src;
+    j.n = n;
+    j.gqr = sGqr6;
+    j.lc = re4SkinLc;
+    j.kind = kind;
+    __atomic_store_n(&re4SkinCount, c + 1, __ATOMIC_SEQ_CST);
+    if (re4_skin_wake_fn) {
+        re4_skin_wake_fn();
+    }
+}
+
+extern "C" int re4_skin_help(int who)
+{
+    u32 i = __atomic_load_n(&re4SkinNext, __ATOMIC_SEQ_CST);
+    for (;;) {
+        if (i >= __atomic_load_n(&re4SkinCount, __ATOMIC_SEQ_CST)) {
+            return 0;
+        }
+        if (__atomic_compare_exchange_n(&re4SkinNext, &i, i + 1, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+            break;
+        }
+    }
+    const Re4SkinJob& j = re4SkinJobs[i];
+    re4SkinRun(j);
+    __atomic_fetch_add(&re4SkinStat[who][0], 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&re4SkinStat[who][1], j.n, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&re4SkinDone, 1, __ATOMIC_SEQ_CST);
+    return 1;
+}
+
+extern "C" void re4SkinJoin()  // C linkage: main.cpp's game loop is inside extern "C"
+{
+    while (re4_skin_help(2)) {
+    }
+    const u32 c = re4SkinCount;
+    while (__atomic_load_n(&re4SkinDone, __ATOMIC_SEQ_CST) != c) {
+        // the jobs others started (an atomic load a pass)
+    }
+    __atomic_store_n(&re4SkinCount, 0, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&re4SkinNext, 0, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&re4SkinDone, 0, __ATOMIC_SEQ_CST);
+    re4SkinArenaUsed = 0;
+    if (re4SkinOn > 0 && ++re4SkinFrames == 300) {
+        double jobs = 0, vtx = 0;
+        for (int w = 0; w < 3; w++) {
+            jobs += re4SkinStat[w][0];
+            vtx += re4SkinStat[w][1];
+        }
+        const double v = vtx > 0 ? vtx : 1;
+        re4_log("skin jobs (per frame, 300 frames): %.1f jobs, %.0f vertices; by vertices: GX thread %.0f%%, the game "
+                "waiting %.0f%%, at the join %.0f%%; palettes %.1f KB; %.1f skinned at once",
+                jobs / 300, vtx / 300, 100.0 * re4SkinStat[0][1] / v, 100.0 * re4SkinStat[1][1] / v,
+                100.0 * re4SkinStat[2][1] / v, re4SkinPalBytes / 300.0 / 1024, re4SkinDirect / 300.0);
+        memset(re4SkinStat, 0, sizeof(re4SkinStat));
+        re4SkinFrames = 0;
+        re4SkinPalBytes = 0;
+        re4SkinDirect = 0;
+    }
+}
