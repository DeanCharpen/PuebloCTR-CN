+/* port (3.6): the GX state a run of sprites shares. The ordering table's kind-8 entries (EspTrans: EspCommonTrans
+   without shimmer, nega, mask) come one after another, and every sprite sets the blend mode, ChannelSet's TEV stage 0
+   and channel, the material colour and the current matrix again -- mostly the values of the sprite before. Level
+   re4_esp_state (RE4_ESP_STATE, 2 by default): 0 the original; 1 a call is left out when its arguments are those the
+   sprite before in the run set (GX keeps them: nothing runs between the entries); 2 also no normal matrix for a sprite
+   without lighting (ChannelSet turns the channel's lights off, the texture coordinates come from TEX0). A run: a call
+   straight from the table, the entry before of kind 8 and its call the last one seen (g_OtSerial). */
+int re4_esp_state = -1;
+static struct {
+    u32 serial;      // g_OtSerial of the last call straight from the table
+    u8 live;         // the last call was one
+    u8 ok;           // this call continues the run
+    u8 haveBlend, haveChan, haveCol, haveMtx;
+    u8 blend[4];
+    u32 chanKey;     // m_Tool_flg & 0x20080 of the unlit TEV/channel setup
+    GXColor col;
+} s_espRun;
+
+static void espRunForget()
+{
+    s_espRun.haveBlend = s_espRun.haveChan = s_espRun.haveCol = s_espRun.haveMtx = 0;
+}
+
+static void espRunEnter()
+{
+    if (re4_esp_state < 0) {
+        const char* e = getenv("RE4_ESP_STATE");
+        re4_esp_state = e ? atoi(e) : 2;
+    }
+    const int direct = re4_esp_state > 0 && g_OtCurFunc == (void (*)(void*)) EspCommonTrans;
+    s_espRun.ok = direct && s_espRun.live && OtGetPrevKind() == 8 && s_espRun.serial + 1 == g_OtSerial;
+    if (!s_espRun.ok) {
+        espRunForget();
+    }
+    s_espRun.live = direct;
+    s_espRun.serial = g_OtSerial;
+}
+
 
